# bargein needs no keys: tests, `npm run lesson` and the demo use a local practice mock server.
# Optional (planned relay in a later version, server-side only; never expose in the browser):
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Mock server settings (all optional)
# BARGEIN_MOCK_PORT=8787
# BARGEIN_BURST_MS=500
# BARGEIN_STALL_MS=1200
