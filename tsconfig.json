{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": false,
    "paths": {
      "bargein": [
        "./src/index.ts"
      ],
      "bargein/openai": [
        "./src/openai.ts"
      ],
      "bargein/gemini": [
        "./src/gemini.ts"
      ]
    }
  },
  "include": [
    "src",
    "test",
    "demo",
    "examples/*.ts"
  ]
}
